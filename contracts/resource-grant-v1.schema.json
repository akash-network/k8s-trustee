{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocl:trustee:resource-grant:v1",
  "title": "OCL Trustee resource grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workload",
    "expectation",
    "resources",
    "expiresAt"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "dseq", "gseq", "oseq", "service", "replica"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^akash1[0-9a-z]+$"
        },
        "dseq": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "gseq": {
          "type": "integer",
          "minimum": 1
        },
        "oseq": {
          "type": "integer",
          "minimum": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "replica": {
          "const": 0
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initdataSha256", "cpuTee", "gpu"],
      "properties": {
        "initdataSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cpuTee": {
          "const": "snp"
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecture", "count"],
          "properties": {
            "architecture": {
              "enum": ["blackwell", "hopper"]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "type", "tag", "sha256"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "environment",
              "registry-auth",
              "security-policy",
              "signing-key",
              "volume-key"
            ]
          },
          "tag": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
